{
  "name": "harmonytrainer",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "server"
  ],
  "scripts": {
    "build": "npm run build -w web && npm run build -w server",
    "test": "npm test --workspaces",
    "check": "npm run check --workspaces && tsc -p e2e",
    "start": "npm start -w server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
